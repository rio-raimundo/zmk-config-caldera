// Here is where we define the DEFAULT keymap for the keyboard. Users can override this if they want to.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/consumer.h>

/ {
    behaviors {
		// When tapped it toggles the layer, when held for longer than 200ms it deactivates on release
        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {  // Layer 0
			bindings = <

	&kp ESC        &kp N1       &kp N2       &kp N3       &kp N4       &kp N5            &kp N6        &kp N7       &kp N8       &kp N9       &kp N0       &kp BSPC
	&kp TAB        &kp Q        &kp W        &kp E        &kp R        &kp T             &kp Y         &kp U        &kp I        &kp O        &kp P        &kp BSLH
	&mo_tog 1 1    &kp A        &kp S        &kp D        &kp F        &kp G             &kp H         &kp J        &kp K        &kp L        &kp SEMI     &kp RET
	&mt LSHFT CAPS &kp Z        &kp X        &kp C        &kp V        &kp B             &kp N         &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp APOS
	&kp LCTRL      &kp LALT     &mo_tog 1 1  &kp DEL      &kp LGUI     &kp SPACE         &kp SPACE     &kp LARW     &kp DARW     &kp UARW     &kp RARW     &kp GRAVE      

			>;
		};
        lower_layer {
			bindings = <

	&kp F1         &kp F2       &kp F3       &kp F4       &kp F5       &kp F6            &kp F7        &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
	&none          &none        &none        &none        &none        &none             &none         &kp LBRC     &kp RBRC     &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE 
	&tog 1         &none        &none        &kp LPAR     &kp RPAR     &none             &none         &kp LBKT     &kp RBKT     &kp MINUS    &kp EQUAL    &none 
	&none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &none         &none        &none        &none        &none        &bt BT_CLR
	&trans         &trans       &trans       &trans       &trans       &trans            &trans        &trans       &trans       &trans       &trans       &none

			>;
        };
    };
};